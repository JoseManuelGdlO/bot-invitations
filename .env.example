# =============================================================================
# Alanna — Variables de entorno para producción (EasyPanel)
# =============================================================================
# Copia este archivo como `.env` en la raíz del repo.
# Docker Compose lee `.env` para back y front (MySQL externo en el servidor).

# -----------------------------------------------------------------------------
# Backend (servicio: back) — dominio: api.tudominio.com
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=4000

# URL pública del front (CORS + cookies). Sin barra final.
CLIENT_URL=https://alannaconfirmaciones.com.mx
CORS_ORIGIN=https://alannaconfirmaciones.com.mx,https://www.alannaconfirmaciones.com.mx

# Host del servicio MySQL en EasyPanel (nombre del servicio, ej. mysql)
DB_HOST=mysql
DB_PORT=3306
DB_USER=alanna
DB_PASSWORD=cambiar-password-seguro
DB_NAME=alanna

JWT_ACCESS_SECRET=cambiar-por-string-aleatorio-min-32-chars
JWT_REFRESH_SECRET=cambiar-por-otro-string-aleatorio-min-32-chars
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES_DAYS=7
JWT_REFRESH_REMEMBER_DAYS=30

FRONTEND_RESET_URL=https://alannaconfirmaciones.com.mx/restablecer-contrasena
WORKER_INTERVAL_MS=5000
# Tope Meta de conversaciones iniciadas por el negocio (plantilla en frío) por número / 24 h. 0 = sin tope.
WA_MAX_INITIAL_CONVERSATIONS_24H=1000

ADMIN_EMAIL=admin@alannaconfirmaciones.com.mx
ADMIN_PASSWORD=cambiar-password-admin

# Stripe (Dashboard → Developers → API keys + Webhooks)
# Webhook endpoint: https://api.alannaconfirmaciones.com.mx/api/billing/webhook
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# WhatsApp Connect (proxy hacia el servicio externo; el JWT nunca se expone al front)
CREDENTIALS_ENCRYPTION_KEY=
WC_API_URL=
WC_SERVICE_JWT=

# WhatsApp Cloud API (Meta). Credenciales por planner (tabla whatsapp_credentials).
# Callback URL: https://api.alannaconfirmaciones.com.mx/api/webhooks/meta
META_WEBHOOK_VERIFY_TOKEN=
META_TEMPLATE_NAME=
META_TEMPLATE_LANGUAGE=es_MX
META_GRAPH_VERSION=v21.0

# SMTP (invitaciones de equipo y recuperación de contraseña). Sin esto el API guarda el miembro pero no manda correo.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# -----------------------------------------------------------------------------
# Frontend (servicio: front) — dominio: app.tudominio.com
# IMPORTANTE: VITE_* se usan en BUILD-TIME; cambiarlas requiere redeploy.
# -----------------------------------------------------------------------------
VITE_API_URL=https://api.alannaconfirmaciones.com.mx/api
VITE_SITE_URL=https://alannaconfirmaciones.com.mx
VITE_GA4_MEASUREMENT_ID=
VITE_GSC_VERIFICATION=
